# 优惠券发放与核销中心 — 配置模板
# 用法：复制为 .env 并填入真实值。.env 已被 .gitignore 排除（NFR-004）。
# 本文件不得包含任何真实凭证。

# ---- 数据库（CON-004）----
DATABASE_URL=postgresql+psycopg://coupon:coupon@localhost:5432/coupon

# ---- 认证（FR-060）----
# 部署时必须覆盖默认值。
JWT_SECRET=dev-only-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ---- Mock 用户 seed（FR-062）----
# FR-010 AC-1 的并发验收需要 N+1 个不同用户，故批量生成。
SEED_NORMAL_USER_COUNT=200

# ---- 风控阈值（FR-050，演示现场可调，改后重启即生效）----
RISK_WINDOW_SECONDS=10
RISK_HARD_THRESHOLD=10
RISK_GRAY_LOW=5
RISK_ENABLED=true

# ---- Amazon Bedrock（FR-042 / CON-002）----
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0

# Bedrock API Token。当前使用**短期 key，有效期 12 小时**。
# 过期后在此替换新值并重启服务即生效，系统不实现自动续期。
# 留空时服务仍可正常启动，AI 功能自动进入降级模式（FR-071 AC-2、FR-041、FR-051）。
# 切勿把真实值提交进仓库或放入演示材料截图。
AWS_BEARER_TOKEN_BEDROCK=

# 超时分级：风控位于领券交易链路上，故比推荐更严格。
BEDROCK_RECOMMEND_TIMEOUT_SECONDS=3.0
BEDROCK_RECOMMEND_MAX_RETRIES=1
BEDROCK_RISK_TIMEOUT_SECONDS=2.0
BEDROCK_RISK_MAX_RETRIES=0

# ---- 推荐（FR-040）----
RECOMMEND_CANDIDATE_LIMIT=20
RECOMMEND_RESULT_LIMIT=5
